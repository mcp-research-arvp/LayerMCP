# Copy this file to .env in the repository root. The real .env is ignored by Git.
# Set only paths available in your own environment; leave unused values blank.
LAYERMCP_REPO_ROOT=

# Phase 2 Slurm environment; blank defaults to $LAYERMCP_REPO_ROOT/.venv.
# Relative paths resolve from LAYERMCP_REPO_ROOT; external environments are supported.
LAYERMCP_VENV=

# Optional site-specific Phase 2 submission settings.  Leave blank to use your
# scheduler/site defaults; submit_phase2.sh forwards non-empty values to sbatch.
LAYERMCP_MODULES=
LAYERMCP_SLURM_ACCOUNT=
LAYERMCP_SLURM_PARTITION=
LAYERMCP_SLURM_GRES=
LAYERMCP_SLURM_CPUS_PER_TASK=
LAYERMCP_SLURM_MEM=
LAYERMCP_SLURM_TIME=

# Optional actual-checkpoint locations for the notebook's <family>_checkpoint modes.
LAYERMCP_GPT_OSS_CHECKPOINT=
LAYERMCP_LLAMA31_8B_CHECKPOINT=
LAYERMCP_QWEN36_CHECKPOINT=
LAYERMCP_GEMMA4_CHECKPOINT=
LAYERMCP_PHI4_CHECKPOINT=

# Optional saved GPT-OSS reasoning-low baseline run for the notebook's
# one-sample control/intervention comparison.  The notebook never downloads it.
LAYERMCP_GPT_OSS_SOURCE_RUN=

# Optional local tokenizer asset directory for the repository GPT-OSS Harmony runtime.
TIKTOKEN_ENCODINGS_BASE=
