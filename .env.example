# Copy this file to .env in the repository root. The real .env is ignored by Git.
# Set only paths available in your own environment; leave unused values blank.
LAYERMCP_REPO_ROOT=

# Optional actual-checkpoint locations for the notebook's <family>_checkpoint modes.
LAYERMCP_GPT_OSS_CHECKPOINT=
LAYERMCP_LLAMA31_8B_CHECKPOINT=
LAYERMCP_QWEN36_CHECKPOINT=
LAYERMCP_GEMMA4_CHECKPOINT=
LAYERMCP_PHI4_CHECKPOINT=

# Optional local tokenizer asset directory for the repository GPT-OSS Harmony runtime.
TIKTOKEN_ENCODINGS_BASE=
